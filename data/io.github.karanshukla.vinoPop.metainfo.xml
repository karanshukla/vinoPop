<component type="desktop-application">
  <id>io.github.karanshukla.vinoPop</id>
  <launchable type="desktop-id">io.github.karanshukla.vinoPop.desktop</launchable>
  <name>vinoPop</name>
  <summary>Context-aware actions for the text you select</summary>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>MIT</project_license>
  <developer id="io.github.karanshukla">
    <name>Karan Shukla</name>
  </developer>
  <description>
    <p>
      Select text in any application to open a floating action bar above it.
      Copy, search, translate, summarize, or rewrite text with a local AI
      model, run shell commands, encode values, or evaluate expressions
      directly where you are working.
    </p>
    <ul>
      <li>Context-aware actions for links, shell commands, file paths, email addresses, and plain text</li>
      <li>Local AI inference on Intel NPU, GPU, or CPU via OpenVINO</li>
      <li>Clipboard history and reusable snippets with placeholders</li>
      <li>Extensible with standalone Python plugins or the built-in no-code recipe builder</li>
    </ul>
  </description>
  <categories>
    <category>Utility</category>
    <category>TextTools</category>
  </categories>
