<component type="desktop-application">
  <id>io.github.karanshukla.vinoPop</id>
  <launchable type="desktop-id">io.github.karanshukla.vinoPop.desktop</launchable>
  <name>vinoPop</name>
  <summary>Context-aware actions for the text you select</summary>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>MIT</project_license>
  <developer id="io.github.karanshukla">
    <name>Karan Shukla</name>
  </developer>
  <description>
    <p>
      Select some text and a small bar of buttons appears right above it.
      Copy it, search it, translate, summarize or rewrite it with a local
      model, run it as a command, encode it or do maths on it, without
      moving your hands from where you were working.
    </p>
    <ul>
      <li>Buttons that fit what you selected: links, commands, file paths, emails and plain text</li>
      <li>Offline AI on the Intel NPU, GPU or CPU: nothing leaves your machine</li>
      <li>Clipboard history and snippets with placeholders</li>
      <li>Plugins are plain Python files, and custom buttons need no code</li>
    </ul>
  </description>
  <categories>
    <category>Utility</category>
    <category>TextTools</category>
  </categories>
  <keywords>
    <keyword>popup</keyword>
    <keyword>clipboard</keyword>
    <keyword>snippets</keyword>
    <keyword>text</keyword>
  </keywords>
