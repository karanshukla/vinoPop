#!/usr/bin/env python3
"""vinoPop: `vinopop [--no-tray] [--debug] [--doctor [--json]] [--trigger ACTION]`.

The app is main.py; this is what launchers, autostart and the docs run, so
the process is called `vinopop` in ps, top and pgrep/pkill rather than
`python3 main.py`.
"""

import sys

PR_SET_NAME = 15


def _set_process_name(name: bytes) -> None:
    """Set `comm`, which threads started afterwards inherit."""
    try:
        import ctypes

        ctypes.CDLL(None).prctl(PR_SET_NAME, name, 0, 0, 0)
    except (OSError, AttributeError):
        pass


_set_process_name(b"vinopop")

# `--doctor` (over SSH, or with a broken display) and `--trigger` (run by a
# desktop shortcut on every press) exit before GTK is imported.
if "--doctor" in sys.argv[1:]:
    from vino_ai import doctor

    sys.exit(doctor.main(as_json="--json" in sys.argv[1:]))

from core import remote  # noqa: E402

if (action := remote.trigger_arg(sys.argv[1:])) is not None:
    sys.exit(remote.send(action))

import main  # noqa: E402

sys.exit(main.main())
